{
  "name": "jev-experiments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two Jev (TypeSafe System One) experiments: halo/ (agent security classification) and prism/ (sensitive-data detection + masking).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/soumyacodes007/jev-experiments.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"halo/test/*.test.mjs\" \"prism/test/*.test.mjs\"",
    "halo:test": "node --test \"halo/test/*.test.mjs\"",
    "halo:eval": "node halo/evals/run.mjs",
    "halo:eval:dev": "node halo/evals/run.mjs --split dev",
    "halo:eval:holdout": "node halo/evals/run.mjs --split holdout",
    "halo:eval:sealed": "node halo/evals/sealed.mjs",
    "halo:eval:consistency": "node halo/evals/consistency.mjs",
    "halo:redteam": "node halo/evals/redteam.mjs",
    "halo:replay": "node halo/evals/replay.mjs",
    "halo:report": "node halo/evals/report.mjs",
    "halo:serve": "node halo/src/server.js",
    "prism:test": "node --test \"prism/test/*.test.mjs\"",
    "prism:eval": "node prism/evals/prism-evaluate.mjs",
    "prism:serve": "node prism/src/cli.mjs serve",
    "prism:mask": "node prism/src/cli.mjs mask",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start"
  },
  "dependencies": {},
  "devDependencies": {}
}
